{
    "info": {
        "_postman_id": "sigan-api-tests-id-2026",
        "name": "SIGAN - Sistema Integrado de Gestão de Alunos",
        "description": "Coleção de testes de API para o projeto SIGAN (NPOR/5° BE Cmb Bld). Contém testes de autenticação, listagem e cadastro de discentes com validações positivas e negativas.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. Autenticação (Login)",
            "item": [
                {
                    "name": "Login com Sucesso",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"admin@npor.eb.mil.br\",\n    \"senha\": \"senha_segura_123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "login"
                            ]
                        },
                        "description": "Testa o login com credenciais válidas. O script de teste armazena automaticamente o token JWT gerado."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code deve ser 200 (OK)\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Deve retornar um token JWT\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData).to.have.property('token');",
                                    "    // Salva o token automaticamente nas variáveis de ambiente",
                                    "    pm.environment.set(\"token\", jsonData.token);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Login - Senha Incorreta (Negativo)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"admin@npor.eb.mil.br\",\n    \"senha\": \"senha_errada_militar\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "login"
                            ]
                        },
                        "description": "Testa a tentativa de login com uma senha errada. Deve retornar erro 401."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code deve ser 401 (Unauthorized)\", function () {",
                                    "    pm.response.to.have.status(401);",
                                    "});",
                                    "",
                                    "pm.test(\"Deve retornar mensagem de erro adequada\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.mensagem).to.include(\"Credenciais inválidas\");",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "2. Gestão de Discentes (Alunos)",
            "item": [
                {
                    "name": "Listar Alunos (Dashboard)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/alunos",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "alunos"
                            ]
                        },
                        "description": "Busca a lista de alunos para o Dashboard utilizando o Token JWT obtido no login."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code deve ser 200 (OK)\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Deve retornar uma lista (Array)\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData).to.be.an('array');",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Cadastrar Aluno com Sucesso",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"numero_aluno\": 1054,\n    \"nome_completo\": \"Carlos Alberto Santos\",\n    \"nome_guerra\": \"Santos\",\n    \"companhia\": \"1ª Cia\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/alunos",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "alunos"
                            ]
                        },
                        "description": "Efetua o cadastro completo de um novo discente com sucesso."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code deve ser 201 (Created)\", function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "",
                                    "pm.test(\"Deve retornar os dados do aluno cadastrado\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData).to.have.property('id');",
                                    "    pm.expect(jsonData.nome_guerra).to.eql(\"Santos\");",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Cadastrar Aluno - Sem NIM (Negativo)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"nome_completo\": \"Aluno Incompleto Sem Numero\",\n    \"nome_guerra\": \"Incompleto\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/alunos",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "alunos"
                            ]
                        },
                        "description": "Tentativa de cadastro sem enviar o campo obrigatório 'numero_aluno' (NIM)."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code deve ser 400 (Bad Request)\", function () {",
                                    "    pm.response.to.have.status(400);",
                                    "});",
                                    "",
                                    "pm.test(\"Deve validar a obrigatoriedade do campo\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.erro).to.include(\"NIM\");",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:3000",
            "type": "string"
        },
        {
            "key": "token",
            "value": "",
            "type": "string"
        }
    ]
}